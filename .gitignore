# ==========================================
# 操作系统自动生成的垃圾文件（无需版本管理）
# ==========================================
# Windows 缩略图与桌面布局缓存
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS 系统属性与临时文件
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# ==========================================
# 编辑器与开发工具临时缓存
# ==========================================
# VS Code / Cursor 个人偏好与缓存
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains 系列 IDE
.idea/

# 文本编辑器临时与交换文件
*.swp
*.swo
*~
*.bak

# ==========================================
# 敏感凭据与个人隐私（严禁上传提交）
# ==========================================
# 环境变量与密钥文件
.env
.env.*
!.env.example

# 账号登录凭证与授权 Token（如 Google 凭证、API Key 等）
credentials.json
token.json
*.key
*.pem
*.cert
*.crt
.cli-proxy-api/

# ==========================================
# 临时文件与运行日志
# ==========================================
*.log
logs/
*.tmp
*.temp

# ==========================================
# 大文件、二进制安装包与压缩包
# ==========================================
# 避免将几十上百兆的压缩包或可执行文件误提交进 Git
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.exe
*.msi
*.iso

# ==========================================
# 运行环境依赖缓存（Python / Node 等）
# ==========================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
node_modules/